# Application database. Never commit a real connection string.
DATABASE_URL=

# Temporary Plesk Basic Auth deployment mode.
AUTH_DISABLED=false

# Read-only SoftOne SQL Server synchronization.
SOFTONE_SQL_SYNC_ENABLED=false
SOFTONE_SQL_INVOICE_SYNC_ENABLED=false
# Optional extension of invoice sync: closed/fully paid customer documents.
# Preview remains read-only even when this flag is false.
SOFTONE_SQL_PAID_INVOICE_SYNC_ENABLED=false
SOFTONE_SQL_PAID_INVOICE_YEAR=2026
SOFTONE_SQL_VESSEL_SYNC_ENABLED=false
SOFTONE_SQL_VESSEL_OWNER_SYNC_ENABLED=false
SOFTONE_SQL_CONTRACT_INSTALLMENT_SYNC_ENABLED=false
SOFTONE_SQL_SERVER=
SOFTONE_SQL_PORT=
SOFTONE_SQL_DATABASE=
SOFTONE_SQL_USER=
SOFTONE_SQL_PASSWORD=
SOFTONE_SQL_ENCRYPT=false
SOFTONE_SQL_TRUST_SERVER_CERTIFICATE=false
